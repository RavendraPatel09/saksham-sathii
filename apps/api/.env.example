# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL with pgvector support)
# Set your actual Postgres connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saksham?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Security & JWT Tokens
JWT_ACCESS_SECRET="your-super-secret-access-token-key-change-in-prod"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-prod"

# LLM Providers (Anthropic or OpenAI for embeddings)
ANTHROPIC_API_KEY="your-anthropic-api-key"
OPENAI_API_KEY="your-openai-api-key"
EMBEDDING_MODEL="text-embedding-3-small"
